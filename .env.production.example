# Public hostname served by the host Apache instance.
APP_HOST=refjuplay-together.example.org

# Only loopback bindings; Apache is the public entry point.
FRONTEND_PORT=18080
BACKEND_PORT=18000

# Use a long URL-safe value, for example: openssl rand -hex 32
POSTGRES_DB=lanparty
POSTGRES_USER=lanparty
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_HEX_VALUE

# Provider and metadata credentials. Leave unused integrations empty.
STEAM_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
RAWG_API_KEY=
XBOX_CLIENT_ID=

# 4 GiB. Apache must allow at least the same request size.
PLAYNITE_UPLOAD_MAX_BYTES=4294967296
